# Copy this file to .env.staging and set real values before deployment.

# API
API_CORS_ORIGINS=https://staging.epi-engine.example
AUTH_JWT_SECRET=replace-with-strong-secret
AUTH_JWT_ISSUER=epi-engine
AUTH_JWT_AUDIENCE=epi-engine-clients

# ClickHouse
CLICKHOUSE_USER=epi_engine_app
CLICKHOUSE_PASSWORD=replace-with-strong-password

# Web
NEXT_PUBLIC_API_BASE_URL=https://staging-api.epi-engine.example
# Use a staging token signed by AUTH_JWT_SECRET with a non-admin role for browser calls.
NEXT_PUBLIC_API_AUTH_TOKEN=replace-with-staging-bearer-token

# Cloudflare Access / staging hostnames
CLOUDFLARE_STAGING_WEB_HOST=staging.epi-engine.example
CLOUDFLARE_STAGING_API_HOST=staging-api.epi-engine.example
