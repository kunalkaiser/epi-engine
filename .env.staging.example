# Copy this file to .env.staging and set real values before deployment.

# API
API_CORS_ORIGINS=https://staging.epi-engine.example
AUTH_JWT_SECRET=replace-with-strong-secret
AUTH_JWT_ISSUER=epi-engine
AUTH_JWT_AUDIENCE=epi-engine-clients
DB_FALLBACK_ENABLED=false
API_METRICS_ENABLED=true
TRACE_HEADER_NAME=X-Request-ID

# ClickHouse
CLICKHOUSE_USER=epi_engine_app
CLICKHOUSE_PASSWORD=replace-with-strong-password

# Web
API_BASE_URL=http://api:8000
# Use a staging bearer token signed by AUTH_JWT_SECRET.
API_AUTH_TOKEN=replace-with-staging-bearer-token
# Optional browser-visible API URL for links/debug only.
NEXT_PUBLIC_API_BASE_URL=https://staging-api.epi-engine.example

# Worker
WORKER_LOOP_INTERVAL_SECONDS=120
WORKER_SIMULATION_BATCH_SIZE=10
WORKER_HEARTBEAT_FILE=/tmp/epios-worker-heartbeat

# Cloudflare Access / staging hostnames
CLOUDFLARE_STAGING_WEB_HOST=staging.epi-engine.example
CLOUDFLARE_STAGING_API_HOST=staging-api.epi-engine.example
# Host path to tunnel credentials JSON used by cloudflared compose profile.
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=/opt/epi-engine/secrets/cloudflared/tunnel-credentials.json
