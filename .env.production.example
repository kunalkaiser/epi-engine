# Copy to .env.production for production runtime (do not commit real secrets).

# Core environment
APP_ENV=production
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=https://epios.example.com
DB_FALLBACK_ENABLED=false
API_METRICS_ENABLED=true
TRACE_HEADER_NAME=X-Request-ID

# Auth (required, operator-managed)
AUTH_JWT_SECRET=replace-with-strong-secret
AUTH_JWT_ISSUER=epi-engine
AUTH_JWT_AUDIENCE=epi-engine-clients
REQUIRE_TENANT_CLAIM_NON_DEV=true

# ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=epi_engine
CLICKHOUSE_USER=epi_engine_app
CLICKHOUSE_PASSWORD=replace-with-strong-password
CLICKHOUSE_TIMEOUT_SECONDS=5

# Web runtime (server-side)
API_BASE_URL=http://api:8000
API_AUTH_TOKEN=replace-with-production-service-token
NEXT_PUBLIC_API_BASE_URL=https://api.epios.example.com

# Worker
WORKER_LOOP_INTERVAL_SECONDS=120
WORKER_SIMULATION_BATCH_SIZE=10
WORKER_HEARTBEAT_FILE=/tmp/epios-worker-heartbeat

# Cloudflare (operator-managed)
CLOUDFLARE_STAGING_WEB_HOST=epios.example.com
CLOUDFLARE_STAGING_API_HOST=api.epios.example.com
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=/opt/epios/secrets/cloudflared/tunnel-credentials.json
